# Postgres connection string. Free hosting tiers (Render/Railway) wipe local
# disk on every restart/redeploy, so this must be a real Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/fixme?schema=public"

PORT=4000
NODE_ENV=development

# Long random strings — used to sign access/refresh JWTs.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:4000,http://localhost:5173"

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers).
# Used for wallet top-ups and artisan withdrawals (Transfer API).
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Escrow auto-release window if the customer never explicitly confirms a
# completed job.
ESCROW_AUTO_RELEASE_HOURS=24

# Platform commission (percent, integer 0-100) taken from each completed
# booking before the artisan's escrow share is released.
PLATFORM_COMMISSION_PERCENT=10

# DEV ONLY — lets every "pay by wallet" step succeed regardless of balance,
# so the full app can be clicked through end-to-end without needing real
# Paystack funds first. Unset (or "false") before treating this as production.
DEV_BYPASS_PAYMENTS=true
