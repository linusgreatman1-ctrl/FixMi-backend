generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ARTISAN
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  phone        String?       @unique
  passwordHash String?
  isGuest      Boolean       @default(false)
  role         Role          @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  avatarUrl    String?
  address      String?
  state        String?
  lga          String?

  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  isSuperAdmin Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artisanProfile   ArtisanProfile?
  wallet           Wallet?
  notificationPref NotificationPreference?

  refreshTokens    RefreshToken[]
  bookingsAsCust   Booking[]         @relation("CustomerBookings")
  notifications    Notification[]
  ratingsGiven     Rating[]          @relation("RatingsGiven")
  supportTickets   SupportTicket[]
  chatParticipants ChatParticipant[]
  corporatePlans   CorporatePlan[]

  addresses         SavedAddress[]
  favourites        Favourite[]
  kycDocuments      KycDocument[]
  emergencyContacts EmergencyContact[]
  safetyReports     SafetyReport[]
  featureBoosts     FeatureBoost[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// One row per artisan account. `category` is free text (Electrician,
// Plumber, AC Tech, ... — the frontend's service grid is open-ended, not a
// fixed enum) so new trades never need a migration.
model ArtisanProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  bizName       String?
  bio           String?
  yearsExp      Int?
  idType        String?
  idNumber      String?
  kycStatus     KycStatus @default(PENDING)
  kycNote       String?
  isVerified    Boolean   @default(false)
  isAvailable   Boolean   @default(false)
  lat           Float?
  lng           Float?
  ratingAvg     Float     @default(0)
  ratingCount   Int       @default(0)
  jobsDone      Int       @default(0)
  // Set when the artisan pays to promote their page; they appear in the
  // homepage "Featured" list until this date passes.
  featuredUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings          Booking[]
  offers            BookingOffer[]
  commissionPeriods CommissionPeriod[]
  favouritedBy      Favourite[]
  featureBoosts     FeatureBoost[]

  @@index([category])
  @@index([kycStatus])
  @@index([featuredUntil])
}

enum BookingStatus {
  REQUESTED // customer submitted, broadcast to nearby available artisans
  ACCEPTED // an artisan accepted, awaiting payment
  PAID // customer paid into escrow, artisan can start
  IN_PROGRESS
  COMPLETED // artisan marked done, awaiting customer confirm
  CONFIRMED // customer confirmed, escrow released
  DECLINED
  CANCELLED
  DISPUTED
}

model Booking {
  id         String          @id @default(uuid())
  customerId String
  customer   User            @relation("CustomerBookings", fields: [customerId], references: [id])
  artisanId  String?
  artisan    ArtisanProfile? @relation(fields: [artisanId], references: [id])

  category String
  issue    String
  address  String
  lat      Float?
  lng      Float?

  priceKobo Int // the customer's budget / offered price
  status    BookingStatus @default(REQUESTED)

  // Escrow-first: the customer's budget is taken from their wallet when the
  // request is posted and held here (topped up or partly refunded once a
  // price is agreed). Moves into payout EscrowHolds when the job is done.
  escrowKobo      Int       @default(0)
  agreedPriceKobo Int?
  // Price on Hold: the artisan assesses at the customer's place first and
  // submits the agreed price there (onsitePriceKobo) for the customer to accept.
  priceOnHold     Boolean   @default(false)
  onsitePriceKobo Int?
  arrivedAt       DateTime?

  scheduledAt  DateTime?
  acceptedAt   DateTime?
  paidAt       DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escrowHolds EscrowHold[]
  chatThread  ChatThread?
  ratings     Rating[]
  offers      BookingOffer[]

  // Raised under a corporate plan: the budget comes from the plan's escrow
  // instead of the customer's wallet, and refunds go back to the plan.
  corporatePlanId String?
  corporatePlan   CorporatePlan? @relation(fields: [corporatePlanId], references: [id])

  @@index([customerId])
  @@index([artisanId])
  @@index([status])
}

enum OfferStatus {
  PENDING // waiting on the other side
  ACCEPTED // this artisan got the job
  DECLINED // artisan declined the request
  REJECTED // customer turned this artisan's offer down
  CLOSED // the request went to someone else or was cancelled
}

// One row per artisan responding to an open request: their price (or Price
// on Hold), the customer's counter, and who spoke last. Also records an
// artisan's decline so the request never comes back to them.
model BookingOffer {
  id                String         @id @default(uuid())
  bookingId         String
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artisanId         String
  artisan           ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  priceKobo         Int?
  isHold            Boolean        @default(false)
  customerPriceKobo Int?
  lastBy            String         @default("ARTISAN")
  status            OfferStatus    @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([bookingId, artisanId])
  @@index([artisanId])
}

// A business's Corporate Plan: paid up front into its own escrow balance,
// which each corporate job draws its budget from.
model CorporatePlan {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  plan       String // BASIC / STANDARD / VIP
  label      String
  priceKobo  Int
  period     String // week / month / year
  callsTotal Int // 0 = unlimited
  callsUsed  Int       @default(0)
  categories String[]
  escrowKobo Int       @default(0)
  startsAt   DateTime  @default(now())
  endsAt     DateTime
  createdAt  DateTime  @default(now())
  bookings   Booking[]

  @@index([userId])
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKobo Int      @default(0)
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  withdrawals  Withdrawal[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  PAYOUT
  COMMISSION_PAYMENT
  ADJUSTMENT
}

model Transaction {
  id               String          @id @default(uuid())
  walletId         String
  wallet           Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type             TransactionType
  amountKobo       Int
  balanceAfterKobo Int
  bookingId        String?
  reference        String?
  description      String?
  createdAt        DateTime        @default(now())

  @@index([walletId])
  @@index([bookingId])
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED // frozen: a customer reported the job not completed; only an admin decision moves it
}

model EscrowHold {
  id         String       @id @default(uuid())
  bookingId  String
  booking    Booking      @relation(fields: [bookingId], references: [id])
  payerId    String
  payeeId    String? // ArtisanProfile.userId; null = platform commission cut
  amountKobo Int
  status     EscrowStatus @default(HELD)

  autoReleaseAt DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  walletId    String
  wallet      Wallet           @relation(fields: [walletId], references: [id])
  amountKobo  Int
  status      WithdrawalStatus @default(PENDING)
  paystackRef String?
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  @@index([userId])
}

// Weekly platform commission owed by an artisan on completed jobs — mirrors
// the "Pay Commission" screen in the prototype.
model CommissionPeriod {
  id             String         @id @default(uuid())
  artisanId      String
  artisan        ArtisanProfile @relation(fields: [artisanId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  jobsCompleted  Int            @default(0)
  grossKobo      Int            @default(0)
  commissionKobo Int            @default(0)
  paid           Boolean        @default(false)
  paidAt         DateTime?

  @@index([artisanId])
}

// Records every processed Paystack webhook event by its transaction
// reference so a retried delivery (Paystack retries on any non-2xx) can
// never credit a wallet twice.
model PaymentWebhookEvent {
  id        String   @id @default(uuid())
  eventRef  String   @unique
  payload   Json
  createdAt DateTime @default(now())
}

enum RateeRole {
  ARTISAN
  CUSTOMER
}

// Two rows per booking are expected — the customer rates the artisan and
// the artisan rates the customer, independently.
model Rating {
  id          String    @id @default(uuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  raterId     String
  rater       User      @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeRole   RateeRole
  rateeUserId String
  stars       Int
  comment     String?
  createdAt   DateTime  @default(now())

  @@unique([bookingId, raterId])
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  bookingId String?
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  // "Job not completed" disputes are tickets with money attached (as in
  // Handa): filing one freezes the booking's escrow until an admin
  // releases it, refunds it, or splits it. The other party can add their
  // side once.
  isDispute              Boolean   @default(false)
  category               String?
  evidenceUrl            String?
  requestedRefundKobo    Int?
  secondPartyUserId      String?
  secondPartyResponse    String?
  secondPartyEvidenceUrl String?
  secondPartyRespondedAt DateTime?
  resolution             String?
  refundAmountKobo       Int?
  resolvedAt             DateTime?

  @@index([userId])
  @@index([status])
}

enum NotificationType {
  BOOKING
  PAYMENT
  CHAT
  ADMIN
  SYSTEM
  ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model NotificationPreference {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled      Boolean @default(true)
  emailEnabled     Boolean @default(true)
  smsEnabled       Boolean @default(false)
  // Promotions / tips. Booking and payment alerts are never switched off by this.
  marketingEnabled Boolean @default(true)
}

model ChatThread {
  id        String   @id @default(uuid())
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  id       String     @id @default(uuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([threadId])
}

model AppSetting {
  key   String @id
  value Json
}

// ---- Sidebar features (Profile, Settings, Safety & Trust, Promote My Page) ----

// "Settings": addresses a customer books jobs to, so they don't retype them.
model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  state     String?
  lga       String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// "Profile": artisans a customer saved. Moved from localStorage so it follows
// the account across devices.
model Favourite {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, artisanId])
  @@index([userId])
}

enum KycDocType {
  GOVERNMENT_ID
  PROOF_OF_ADDRESS
  TRADE_CERTIFICATE
}

// "Safety & Trust": identity documents behind the "ID Verified" badge. Admin
// reviews each one; the artisan profile flips to verified once an ID is approved.
model KycDocument {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType         KycDocType
  idType          String?
  idNumber        String?
  fileUrl         String
  // Image bytes live in the database: private (served only through an authenticated route) and kept across redeploys.
  fileData        Bytes?
  fileMime        String?
  status          KycStatus  @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@index([status])
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

enum SafetyReportType {
  SOS
  UNSAFE_BEHAVIOUR
  FRAUD
  HARASSMENT
  OTHER
}

enum SafetyReportStatus {
  OPEN
  REVIEWING
  RESOLVED
}

// SOS alerts and user-flagged incidents. An SOS pings every admin and the
// reporter's emergency contacts (when SMS is configured).
model SafetyReport {
  id             String             @id @default(uuid())
  reporterId     String
  reporter       User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  type           SafetyReportType
  bookingId      String?
  reportedUserId String?
  description    String?
  lat            Float?
  lng            Float?
  status         SafetyReportStatus @default(OPEN)
  adminNote      String?
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([reporterId])
}

// "Promote My Page": history of boosts bought, alongside ArtisanProfile.featuredUntil.
model FeatureBoost {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artisanId  String
  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  plan       String
  days       Int
  amountKobo Int
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime       @default(now())

  @@index([artisanId])
}

// Super-admin trail of sensitive admin actions. Actor fields are snapshots so
// an entry stays readable after the admin is removed.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Announcement {
  id             String   @id @default(uuid())
  title          String
  body           String
  targetRoles    String[] @default([])
  sentById       String
  sentByName     String
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
